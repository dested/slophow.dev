DATABASE_URL=postgres://postgres:postgres@localhost:5432/slopshow
BETTER_AUTH_SECRET=replace-me-with-32-plus-random-chars
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth (optional — the "Continue with GitHub" button hides when unset).
# Create at https://github.com/settings/applications/new with callback:
#   <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated emails that get admin (featuring) powers on signup.
ADMIN_EMAILS=

# Where uploaded bundles/images are stored (mount a volume here in prod).
DATA_DIR=./data
