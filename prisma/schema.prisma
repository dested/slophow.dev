// Prisma schema — https://pris.ly/d/prisma-schema
//
// Auth models match better-auth's required shape (user / session / account /
// verification). Field names are camelCase (better-auth queries them by name);
// columns are snake_case via `@map`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @map("updated_at")

  // slopshow profile — username is claimed automatically on signup (from the
  // display name / email local part) and editable in /settings.
  username      String?  @unique
  bio           String?
  website       String?
  githubHandle  String?  @map("github_handle")
  twitterHandle String?  @map("twitter_handle")
  accent        String?  // preset accent key for the profile page (see ui.md)
  isAdmin       Boolean  @default(false) @map("is_admin")

  sessions Session[]
  accounts Account[]
  projects Project[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @map("updated_at")

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @default(now()) @map("updated_at")

  @@map("verification")
}

// A creation someone is showing off. The "AI receipts" fields (models, cost,
// build time, human%) are the point of the site — all optional, all
// self-reported.
model Project {
  id      String @id @default(uuid())
  slug    String
  ownerId String @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  title       String
  tagline     String? // one-liner shown on cards
  description String? // longer "how I built it" text (plain text w/ paragraphs)
  coverImage  String? @map("cover_image") // filename under DATA_DIR/images
  externalUrl String? @map("external_url") // optional "also live at" link
  embedUrl    String? @map("embed_url") // optional URL to embed in the player instead of a zip

  published  Boolean   @default(true)
  featured   Boolean   @default(false)
  featuredAt DateTime? @map("featured_at")

  // Admin moderation. Projects are only publicly visible when they are both
  // published (owner's toggle) AND approved (admin's toggle). New projects and
  // re-uploaded bundles land as 'pending'; an admin moves them to 'approved' or
  // 'rejected' (with an optional note surfaced back to the owner).
  moderationStatus String    @default("pending") @map("moderation_status") // pending | approved | rejected
  reviewNote       String?   @map("review_note")
  reviewedAt       DateTime? @map("reviewed_at")

  // AI receipts
  models       String[] @default([]) // e.g. ["Claude Opus 4.6"]
  tools        String[] @default([]) // e.g. ["Claude Code", "Cursor"]
  costUsd      Float?   @map("cost_usd") // self-estimated spend
  buildHours   Float?   @map("build_hours") // wall-clock time to build
  humanPercent Int?     @map("human_percent") // % of code written by hand, 0–100
  promptNotes  String?  @map("prompt_notes") // notable prompts / prompting approach

  // Hosted bundle: files live at DATA_DIR/bundles/<id>/<version>/ with an
  // index.html entry. version 0 = nothing uploaded yet; bumped on re-upload.
  bundleVersion Int  @default(0) @map("bundle_version")
  bundleSize    Int? @map("bundle_size") // uncompressed bytes

  // Denormalized counters (kept in sync when a StatEvent is recorded) so
  // browse/featured sorting never aggregates the events table.
  viewCount  Int @default(0) @map("view_count")
  playCount  Int @default(0) @map("play_count")
  clickCount Int @default(0) @map("click_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  events StatEvent[]

  @@unique([ownerId, slug])
  @@index([featured, featuredAt])
  @@index([published, createdAt])
  @@index([moderationStatus, createdAt])
  @@map("project")
}

// One row per counted interaction. visitorHash = sha256(ip|ua|day) — a view
// is counted at most once per visitor per project per day.
model StatEvent {
  id        String  @id @default(uuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  kind        String // 'view' | 'play' | 'click'
  visitorHash String  @map("visitor_hash")
  referrer    String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([projectId, kind, createdAt])
  @@index([projectId, visitorHash, kind])
  @@map("stat_event")
}
